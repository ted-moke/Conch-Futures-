# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional: point the app at a different Firebase project.
# When VITE_FIREBASE_PROJECT_ID is unset, the committed
# firebase-applet-config.json is used (the AI Studio default).
# VITE_FIREBASE_DATABASE_ID is only needed if the project uses a named
# Firestore database; leave unset for "(default)".
# VITE_FIREBASE_API_KEY=""
# VITE_FIREBASE_AUTH_DOMAIN=""
# VITE_FIREBASE_PROJECT_ID=""
# VITE_FIREBASE_STORAGE_BUCKET=""
# VITE_FIREBASE_MESSAGING_SENDER_ID=""
# VITE_FIREBASE_APP_ID=""
# VITE_FIREBASE_DATABASE_ID=""

# Optional: run `vite` dev against the local Firebase emulators rather than the
# live project, so sign-ins and picks stay off real accounts and data. Applies
# to dev only; production builds always use the real backend. Ports default to
# the Firebase defaults below and only need setting if firebase.json overrides
# them.
# VITE_USE_FIREBASE_EMULATOR="true"
# VITE_FIREBASE_EMULATOR_HOST="localhost"
# VITE_AUTH_EMULATOR_PORT="9099"
# VITE_FIRESTORE_EMULATOR_PORT="8080"

# Optional: serve the app from a sub-path (build-time only).
# Example: VITE_BASE_PATH="/conch/" when embedding under another site.
# VITE_BASE_PATH="/"

# Optional: when embedded under a host site, show a slim bar linking back to
# it. Both must be set for the bar to render.
# VITE_HOST_APP_NAME="Conch FF"
# VITE_HOST_APP_URL="/"
